# ─────────────────────────────────────────────────────────────────────────────
# .env.oracle.example — TEMPLATE do .env da VPS Oracle (piloto DeskcommCRM)
#
# COMO USAR (no servidor; este arquivo e o unico rastreavel pelo Git):
#   cp .env.oracle.example .env
#   $EDITOR .env          # preencha os VAZIOS — nenhum valor aqui ja vale
#   chmod 600 .env
# Preflight (somente leitura, roda quantas vezes quiser):
#   bash scripts/validar-predeploy-oracle.sh
#
# REGRAS:
#   * o `.env` real e ignorado pelo Git e nunca vai para commit, log ou chat;
#   * valores SECRETOS ficam VAZIOS e sao gerados NO SERVIDOR (comandos abaixo);
#   * NUNCA sobrescreva um `.env` ja preenchido com este template;
#   * nao ha Supabase proprio aqui: o projeto hospedado existente e o alvo.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Dominio e HTTPS (Caddy) ───────────────────────────────────────────────
# Dominio REAL, com registro A apontando para o IP da VPS, ANTES do primeiro up
# (o Caddy so emite certificado Let's Encrypt com DNS ja resolvido).
DOMAIN=
ACME_EMAIL=

# ── 2. URLs publicas do app ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
# NEXT_PUBLIC_ADMIN_URL=   # opcional; default = NEXT_PUBLIC_APP_URL

# ── 3. Imagens (pinadas explicitamente; :latest e proibido) ──────────────────
# `:stable` = ultima release publicada no GHCR (canal de release proprio do
# repositorio; manifest com linux/arm64 verificado em 2026-10-10). Para
# congelar uma versao exata troque por tag numerada (ex.: :1.40.0) apos
# conferir com `docker manifest inspect <imagem>`.
APP_IMAGE=ghcr.io/melgarafael/deskcommcrm:stable
WORKER_IMAGE=ghcr.io/melgarafael/deskcomm-worker:stable
SCHEDULER_IMAGE=ghcr.io/melgarafael/deskcomm-scheduler:stable
# ARM64 OBRIGATORIO: devlikeapro/waha:latest-2026.7.2 e so x86_64; em ARM64 a
# tag da mesma versao e noweb-arm-2026.7.2 (compose: WAHA_IMAGE). Em VPS
# x86_64, volte para devlikeapro/waha:latest-2026.7.2.
WAHA_IMAGE=devlikeapro/waha:noweb-arm-2026.7.2

# ── 4. Perfis de compose ─────────────────────────────────────────────────────
# Piloto: VAZIO (voz/telefonia fora). O validador recusa valor nao vazio.
COMPOSE_PROFILES=

# ── 5. Supabase HOSPEDADO (projeto existente; nada de Supabase proprio) ──────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Opcional: string privilegiada do dono do banco, SO para schema/migrations
# (nao e obrigatoria para o app subir; ver docs/deploy-selfhost/README.md §2):
# SUPABASE_DB_ADMIN_URL=

# ── 6. Redis via SRH interno (os DOIS com o MESMO token) ─────────────────────
UPSTASH_REDIS_REST_URL=http://srh:80
UPSTASH_REDIS_REST_TOKEN=
SRH_TOKEN=
#   ↑ gere UM token e use-o nas duas chaves (o srh exige Bearer igual):
#     openssl rand -base64 32

# ── 7. Segredos internos (gere cada um; nunca reutilize entre ambientes) ─────
#   openssl rand -base64 32   (rode no servidor; nao imprima nem cole em chat)
INTERNAL_SECRET=
CPF_ENCRYPTION_KEY=
AI_CRED_AES_KEY=
# Recomendados (o app sobe sem eles, mas o guia selfhost manda gerar):
INTERNAL_CRON_SECRET=
IMPERSONATE_COOKIE_SECRET=
LGPD_SIGNING_KEY=

# ── 8. WAHA (mesma rede do compose; webhook NUNCA publico) ───────────────────
WAHA_API_BASE_URL=http://waha:3000
WAHA_WEBHOOK_BASE_URL=http://app:3000
# Chave de API do WAHA: invente uma frase forte; nunca a exiba em log/chat.
WAHA_API_KEY=
# Depois de preencher a chave acima, gere o hash NO SERVIDOR:
#   echo -n "$WAHA_API_KEY" | shasum -a 512 | awk '{print $1}'
WAHA_API_KEY_SHA512=
WAHA_HMAC_SECRET=
# o waha assina o hook com WAHA_HMAC_SECRET e o app EXIGE a assinatura:
WAHA_WEBHOOK_REQUIRE_SIGNATURE=true
# exigida em producao por lib/env.ts (obrigatoria no compose de prod):
WAHA_BYO_ENCRYPTION_KEY=

# ── 9. Postura do piloto (NAO mudar sem aprovacao do dono) ───────────────────
# O worker de IA fica FORA do primeiro `up` (docs/runbooks/oracle-pilot.md):
# inbound e verificado ANTES de qualquer resposta de IA.
AGENT_DISPATCH_CONSUMER=engine
INTERNAL_AGENT_RUN_STUB=false
WHATSAPP_RESTART_ALL_SESSIONS=True
# IA: nao cadastre chave aqui — depois, em /app/ai/credentials (fica cifrada).
#
# Proibidos neste piloto (se aparecerem, o validador recusa):
#   SINGLE_SERVER=1            -> overlay single-server fora
#   WAHA_HOOK_BASE_URL=...     -> variavel do compose de DESENVOLVIMENTO
#   COMPOSE_FILE=...           -> este piloto usa so docker-compose.prod.yml
